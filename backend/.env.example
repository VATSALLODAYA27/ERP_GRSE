# Copy this file to ".env" (same folder) and fill in what you need. The real .env must never be shared or committed.

# --- Explainer (optional) ---
# A hosted language model that rewords the revision change list in plain English.
# It is sent only the change list, never the drawing, and never affects a verdict.
# Leave the key empty to switch the explainer off.
# A key in the GROQ_API_KEY environment variable is also picked up.
GRSE_EXPLAINER_KEY=
GRSE_EXPLAINER_URL=https://api.groq.com/openai/v1
GRSE_EXPLAINER_MODEL=openai/gpt-oss-20b
# Several keys can be given, separated by commas: when one is busy, the next is used.
# The model tried when the main one is busy (it has its own per-minute allowance):
GRSE_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Other settings (all optional) ---
# GRSE_DATABASE_URL=postgresql+psycopg://user:password@host/grse
# GRSE_COOKIE_SECURE=1
# GRSE_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
